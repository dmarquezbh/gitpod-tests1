<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- .NET 11 Runtime Async was measured on this app: no gain on Kestrel (within noise), so it stays off here. -->
    <UseRuntimeAsync>false</UseRuntimeAsync>

    <!-- Runtime knobs for throughput -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- the raw pipelined PostgreSQL client lives in the platform project; selectable here with DB_DRIVER=raw -->
    <Compile Include="../dotnet-platform/Pg/PgConnection.cs" Link="Pg/PgConnection.cs" />
    <Compile Include="../dotnet-platform/Pg/PendingOps.cs" Link="Pg/PendingOps.cs" />
    <Compile Include="../dotnet-platform/Pg/RawDb.cs" Link="Pg/RawDb.cs" />
  </ItemGroup>

</Project>
